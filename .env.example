# Local development. Copy to .env (vite dev) and .dev.vars (wrangler dev).
# Both are gitignored — never commit real values.

# App base URL, used for Stripe redirects and invite/reset links.
APP_URL=http://localhost:5173
# Apex domain WITHOUT a port. Org bubbles resolve as <slug>.<HALLIFY_DOMAIN>, and
# hooks.server.ts strips the port from the Host header — a value with :5173 breaks them.
HALLIFY_DOMAIN=localhost

# Stripe. Read at runtime via $env/dynamic/private, so these can also be set as
# Worker secrets in deployed environments. Placeholders are fine until you exercise
# checkout or webhooks.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Brevo API key, xkeysib-..., NOT the SMTP key). If unset, sends are skipped
# and recorded in email_log as `failed`.
BREVO_API_KEY=
EMAIL_FROM=noreply@hallify.sk
EMAIL_FROM_NAME=Hallify

# Cloudflare for SaaS custom-hostname management. Optional locally.
CF_ZONE_ID=
CF_API_TOKEN=

# Optional: enables POST /api/cron/cleanup. Without it that route 404s.
CRON_SECRET=

# Google Tag Manager container for the apex marketing/app surface. Org bubbles use
# the venue's OWN container (set per-org in Settings), never this one. Empty = no
# analytics at all, and no consent banner is shown.
GTM_CONTAINER_ID=
