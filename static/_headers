# Cache rules for static files, read by Cloudflare's asset layer. The adapter appends
# its own /_app/immutable/* rule below these at build time. Without them every font
# and photo went out with the platform default, max-age=0, and was revalidated on
# every page view.
#
# Fonts never change in place: a new cut gets a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Marketing photos may be swapped under the same name, so a month, not forever.
/marketing/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=86400
/Hallify.svg
  Cache-Control: public, max-age=604800
/*.wav
  Cache-Control: public, max-age=604800
