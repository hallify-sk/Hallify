{
  "name": "hallify",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "migrate": "npx tsx src/lib/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1067.0",
    "bcryptjs": "^2.4.3",
    "nodemailer": "^8.0.1",
    "postgres": "^3.4.4",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.19.13",
    "@types/nodemailer": "^7.0.11",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "^17.3.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  },
  "type": "module"
}
