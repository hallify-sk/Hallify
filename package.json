{
  "name": "hallify",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:wrangler": "vite build && wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deploy:dev": "npm run build:dev && wrangler deploy --env dev",
    "deploy:prod": "npm run build:prod && wrangler deploy",
    "build:dev": "node scripts/clean-adapter-output.mjs && vite build",
    "build:prod": "node scripts/clean-adapter-output.mjs && vite build",
    "migrate:local": "wrangler d1 migrations apply hallify --local",
    "migrate:dev": "wrangler d1 migrations apply hallify-dev --remote --env dev",
    "migrate:prod": "wrangler d1 migrations apply hallify --remote",
    "migrate:status:local": "wrangler d1 migrations list hallify --local",
    "migrate:status:dev": "wrangler d1 migrations list hallify-dev --remote --env dev",
    "migrate:status:prod": "wrangler d1 migrations list hallify --remote",
    "migrate:new": "wrangler d1 migrations create hallify",
    "seed:local": "wrangler d1 execute hallify --local --file=src/lib/db/seed.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tabler/icons-svelte": "^3.49.0",
    "bcryptjs": "^2.4.3",
    "leaflet": "^1.9.4",
    "pdf-lib": "^1.17.1",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@sveltejs/adapter-cloudflare": "^4.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.19.13",
    "@vitest/coverage-v8": "^4.1.8",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.0.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.3": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "workerd@1.20260611.1": true
  }
}
