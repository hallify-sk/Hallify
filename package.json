{
  "name": "hallify",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:wrangler": "vite build && wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deploy:dev": "npm run build:dev && wrangler deploy --env dev",
    "deploy:prod": "npm run build:prod && wrangler deploy",
    "build:dev": "APP_URL=https://dev.hallify.sk vite build",
    "build:prod": "APP_URL=https://hallify.sk vite build",
    "migrate:dev": "wrangler d1 execute hallify-dev --remote --file=src/lib/db/schema.sql",
    "migrate:prod": "wrangler d1 execute hallify --remote --file=src/lib/db/schema.sql",
    "migrate:local": "wrangler d1 execute hallify --local --file=src/lib/db/schema.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@sveltejs/adapter-cloudflare": "^4.0.0",
    "@sveltejs/kit": "^2.66.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.19.13",
    "@vitest/coverage-v8": "^4.1.8",
    "svelte": "^5.56.3",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.0.0"
  },
  "type": "module"
}
